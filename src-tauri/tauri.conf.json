{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinNUT Rust Client",
  "version": "0.1.11",
  "identifier": "com.admin.ups-client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinNUT Rust Client",
        "width": 1100,
        "height": 650,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NTE3NUY2MDk1OTkwNjYKUldSbWtGa0o5blZSdFVtYkxEYVdZeGFTZWxEQlpvRDVMU1FWajlkTXAzakpvRS8yeExzRmx3L1QK",
      "endpoints": [
        "https://github.com/ppundsh/WinNUT-Client-RS/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}